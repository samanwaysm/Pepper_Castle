<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Signup Page</title>
    <link rel="icon" href="/images/fav.png" sizes="32x32" />
    <!-- Bootstrap CSS -->
    <link href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css" rel="stylesheet">
    <!-- FontAwesome for icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: Arial, sans-serif;
        }

        body {
            margin: 0;
            height: 120vh;
            display: flex;
            align-items: center;
            justify-content: center;
            background: url('/images/pages-top/slider-2.jpg') no-repeat center center fixed;
            background-size: cover;
        }

        .signup-container {
            background-color: rgba(51, 51, 51, 0.8);
            padding: 40px;
            border-radius: 10px;
            max-width: 1000px;
            width: 100%;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.3);
        }

        h2 {
            text-align: center;
            color: #ff6600;
            margin-bottom: 20px;
        }

        .form-group {
            margin-bottom: 20px;
            width: 100%;
        }

        label {
            font-size: 16px;
            color: #ffffff;
            display: block;
            margin-bottom: 5px;
        }

        .form-row {
            display: flex;
            flex-wrap: wrap;
            gap: 15px;
        }

        .form-column {
            flex: 1;
            min-width: 200px;
        }

        input[type="text"],
        input[type="email"],
        input[type="password"],
        input[type="tel"] {
            width: 100%;
            padding: 12px;
            border: 1px solid #666666;
            border-radius: 6px;
            font-size: 16px;
            background-color: #555555;
            color: #ffffff;
        }

        input[type="text"]::placeholder,
        input[type="email"]::placeholder,
        input[type="password"]::placeholder,
        input[type="tel"]::placeholder {
            color: #999999;
        }

        .signup-btn {
            width: 100%;
            padding: 14px;
            background-color: #ff6600;
            color: white;
            border: none;
            border-radius: 6px;
            cursor: pointer;
            font-size: 18px;
        }

        .signup-btn:hover {
            background-color: #e65c00;
        }

        .already-have-account {
            text-align: center;
            margin-top: 15px;
        }

        .already-have-account a {
            text-decoration: none;
            color: #ff6600;
        }

        .already-have-account a:hover {
            text-decoration: underline;
        }

        /* Eye icon style */
        .toggle-password {
            position: absolute;
            right: 10px;
            top: 50%;
            transform: translateY(-50%);
            cursor: pointer;
            font-size: 18px;
            color: #ffffff;
        }

        .error-p {
            color: rgb(255, 238, 0);
            font-size: 13px;
        }

        @media (max-width: 1064px) {
            .signup-container {
                margin-top: 10vh;
                padding: 20px;
                margin-bottom: 10vh;
            }
        }

        /* Responsive design */
        @media (max-width: 768px) {
            .signup-container {
                margin-top: 40vh;
                padding: 20px;
                max-width: 90%;
                margin-bottom: 10vh;
            }

            h2 {
                font-size: 24px;
            }

            .form-column {
                flex: 1 1 100%;
            }

            .signup-btn {
                font-size: 16px;
                padding: 12px;
            }
        }

        @media (max-width: 480px) {
            h2 {
                font-size: 22px;
                margin-bottom: 15px;
            }

            .form-group label {
                font-size: 14px;
            }

            .signup-btn {
                font-size: 14px;
            }
        }

        .logo {
            width: 6%;
            height: auto;
            margin-bottom: 10px;
            margin-left: 47%;
            margin-right: 47%;
        }
        .brand-name {
            font-size: 24px;
            color: #fff;
            font-weight: bold;
            margin-bottom: 20px;
            text-align: center;
        }
    </style>
</head>

<body>
    <div class="signup-container">
        <img src="/images/fav.png" alt="Pepper Castle Logo" class="logo">
        <div class="brand-name">Pepper Castle</div>
        <h2>Signup</h2>
        <%# if (errors && errors.signUpError) { %>
            <!-- <div class="alert alert-danger" role="alert">
                <p class="error-message">
                    <%#= errors.signUpError %>
                </p>
            </div> -->
            <%# } %>
                <form id="signupForm" method="POST" action="/api/signup" novalidate>
                    <!-- User Information -->
                    <div class="form-row">
                        <div class="form-column">
                            <div class="form-group">
                                <label for="username">Username:</label>
                                <input type="text" id="username" name="username" placeholder="Enter your username"
                                    required>
                                <% if (errors && errors.usernameError) { %>
                                    <span class="error-p"><%= errors.usernameError %></span>
                                <% } %>
                                <p class="error-p" id="usernameError"></p>
                            </div>
                        </div>
                        <div class="form-column">
                            <div class="form-group">
                                <label for="email">Email:</label>
                                <input type="email" id="email" name="email" placeholder="Enter your email" required>
                                <% if (errors && errors.emailError) { %>
                                    <span class="error-p"><%= errors.emailError %></span>
                                <% } %>
                                <p class="error-p" id="emailError"></p>
                            </div>
                        </div>
                        <div class="form-column">
                            <div class="form-group">
                                <label for="phone">Phone Number:</label>
                                <input type="tel" id="phone" name="phone" placeholder="Enter your phone number"
                                    required>
                                <% if (errors && errors.phoneError) { %>
                                    <span class="error-p"><%= errors.phoneError %></span>
                                <% } %>
                                <p class="error-p" id="phoneError"></p>
                            </div>
                        </div>
                    </div>

                    <!-- Address Information -->
                    <div class="form-row">
                        <div class="form-column">
                            <div class="form-group">
                                <label for="street">Street Address:</label>
                                <input type="text" id="street" name="street" placeholder="Enter your street address"
                                    required>
                                <% if (errors && errors.streetError) { %>
                                    <span class="error-p"><%= errors.streetError %></span>
                                <% } %>
                                <p class="error-p" id="streetError"></p>
                            </div>
                        </div>
                        <div class="form-column">
                            <div class="form-group">
                                <label for="block">Block/Apartment/Tower:</label>
                                <input type="text" id="block" name="block" placeholder="Enter your block or tower"
                                    required>
                                <% if (errors && errors.blockError) { %>
                                    <span class="error-p"><%= errors.blockError %></span>
                                <% } %>
                                <p class="error-p" id="blockError"></p>
                            </div>
                        </div>
                        <div class="form-column">
                            <div class="form-group">
                                <label for="floor">Floor/Unit Number:</label>
                                <input type="text" id="floor" name="unitnum"
                                    placeholder="Enter your floor or unit number" required>
                                    <% if (errors && errors.unitNumError) { %>
                                        <span class="error-p"><%= errors.unitNumError %></span>
                                    <% } %>
                                <p class="error-p" id="floorError"></p>
                            </div>
                        </div>
                        <div class="form-column">
                            <div class="form-group">
                                <label for="postal">Postal Code:</label>
                                <input type="text" id="postal" name="postal" placeholder="Enter your postal code"
                                    required>
                                <% if (errors && errors.postalError) { %>
                                    <span class="error-p"><%= errors.postalError %></span>
                                <% } %>
                                <p class="error-p" id="postalError"></p>
                            </div>
                        </div>
                    </div>

                    <!-- Password Information -->
                    <div class="form-row">
                        <div class="form-column">
                            <div class="form-group">
                                <label for="password">Password:</label>
                                <div style="position: relative;">
                                    <input type="password" id="password" name="password"
                                        placeholder="Enter your password" required>
                                    <span class="toggle-password" id="togglePassword">
                                        <i class="fas fa-eye" id="eyeIcon"></i>
                                    </span>
                                </div>
                                <% if (errors && errors.passwordError) { %>
                                    <span class="error-p"><%= errors.passwordError %></span>
                                <% } %>
                                <p class="error-p" id="passwordError"></p>
                            </div>
                        </div>
                        <div class="form-column">
                            <div class="form-group">
                                <label for="confirmPassword">Confirm Password:</label>
                                <div style="position: relative;">
                                    <input type="password" id="confirmPassword" name="confirmPassword"
                                        placeholder="Confirm your password" required>
                                    <span class="toggle-password" id="toggleConfirmPassword">
                                        <i class="fas fa-eye" id="confirmEyeIcon"></i>
                                    </span>
                                </div>
                                <% if (errors && errors.confirmPasswordError) { %>
                                    <span class="error-p"><%= errors.confirmPasswordError %></span>
                                <% } %>
                                <p class="error-p" id="confirmPasswordError"></p>
                            </div>
                        </div>
                    </div>

                    <button type="submit" class="signup-btn">Signup</button>
                    <div class="already-have-account">
                        <a href="/signin">Already have an account? SignIn</a>
                    </div>
                </form>
    </div>

    <script>
        const togglePassword = document.getElementById('togglePassword');
        const passwordInput = document.getElementById('password');
        const confirmPasswordInput = document.getElementById('confirmPassword');
        const toggleConfirmPassword = document.getElementById('toggleConfirmPassword');

        togglePassword.addEventListener('click', function () {
            const type = passwordInput.getAttribute('type') === 'password' ? 'text' : 'password';
            passwordInput.setAttribute('type', type);
            this.querySelector('i').classList.toggle('fa-eye-slash');
        });

        toggleConfirmPassword.addEventListener('click', function () {
            const type = confirmPasswordInput.getAttribute('type') === 'password' ? 'text' : 'password';
            confirmPasswordInput.setAttribute('type', type);
            this.querySelector('i').classList.toggle('fa-eye-slash');
        });

        // Form validation
        document.getElementById('signupForm').addEventListener('submit', function (event) {
            event.preventDefault();

            const username = document.getElementById('username').value.trim();
            const email = document.getElementById('email').value.trim();
            const phone = document.getElementById('phone').value.trim();
            const street = document.getElementById('street').value.trim();
            const block = document.getElementById('block').value.trim();
            const floor = document.getElementById('floor').value.trim();
            const postal = document.getElementById('postal').value.trim();
            const password = document.getElementById('password').value.trim();
            const confirmPassword = document.getElementById('confirmPassword').value.trim();

            let formIsValid = true;

            // Clear previous error messages
            document.querySelectorAll('.error-p').forEach(el => el.textContent = "");

            // Required field validation
            if (!username) {
                document.getElementById('usernameError').innerText = "Username is required.";
                formIsValid = false;
            }

            if (!email) {
                document.getElementById('emailError').innerText = "Email is required.";
                formIsValid = false;
            }

            if (!phone) {
                document.getElementById('phoneError').innerText = "Phone number is required.";
                formIsValid = false;
            }

            if (!street) {
                document.getElementById('streetError').innerText = "Street is required.";
                formIsValid = false;
            }

            if (!block) {
                document.getElementById('blockError').innerText = "Block is required.";
                formIsValid = false;
            }

            if (!floor) {
                document.getElementById('floorError').innerText = "Floor is required.";
                formIsValid = false;
            }

            if (!postal) {
                document.getElementById('postalError').innerText = "Postal code is required.";
                formIsValid = false;
            }

            if (!password) {
                document.getElementById('passwordError').innerText = "Password is required.";
                formIsValid = false;
            }

            if (!confirmPassword) {
                document.getElementById('confirmPasswordError').innerText = "Please confirm your password.";
                formIsValid = false;
            }

            // // Username validation
            // if (username.length < 3) {
            //     document.getElementById('usernameError').innerText = "Username must be at least 3 characters.";
            //     formIsValid = false;
            // }

            // if (username !== document.getElementById('username').value.trim()) {
            //     document.getElementById('usernameError').innerText = 'Inputs cannot start or end with spaces.';
            //     return;
            // }

            // Username validation
            if (username && username.length < 3) {
                document.getElementById('usernameError').innerText = "Username must be at least 3 characters.";
                formIsValid = false;
            }
            if (username && username !== document.getElementById('username').value) {
                document.getElementById('usernameError').innerText = 'Inputs cannot start or end with spaces.';
                return;
            }

            // Email validation
            const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
            if (email && !emailRegex.test(email)) {
                document.getElementById('emailError').innerText = "Invalid email format.";
                formIsValid = false;
            }

            // Phone validation (10-15 digits)
            // const phoneRegex = /^[0-9]{10,15}$/;
            // if (!phoneRegex.test(phone)) {
            //     document.getElementById('phoneError').innerText = "Invalid phone number.";
            //     formIsValid = false;
            // }
            const singaporePhoneRegex = /^[689]\d{7}$/;

            if (phone && !singaporePhoneRegex.test(phone)) {
                document.getElementById('phoneError').innerText = "Invalid phone number";
                // document.getElementById('phoneError').innerText = "Invalid Singapore phone number. It should be 8 digits and start with 6, 8, or 9.";
                formIsValid = false;
            }


            const postalCodeRegex = /^\d{6}$/;

            if (postal && !postalCodeRegex.test(postal)) {
                document.getElementById('postalError').innerText = "Invalid postal code.";
                formIsValid = false;
            }

            const passwordPattern = /^(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*[\W_]).{8,}$/;

            if (password && password.length < 8) {
                document.getElementById('passwordError').innerText = "Password must be at least 8 characters long.";
                formIsValid = false;
            } else if (password && !passwordPattern.test(password)) {
                document.getElementById('passwordError').innerText = "Password must contain at least one uppercase letter, one lowercase letter, one number, and one special character.";
                formIsValid = false;
            }

            // // Password validation
            // if (password.length < 6) {
            //     document.getElementById('passwordError').innerText = "Password must be at least 6 characters.";
            //     formIsValid = false;
            // }

            if (password !== confirmPassword) {
                document.getElementById('confirmPasswordError').innerText = "Passwords do not match.";
                formIsValid = false;
            }

            if (formIsValid) {
                this.submit();
            }
        });
    </script>
</body>

</html>